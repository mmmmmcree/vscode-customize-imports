{
  "name": "dark2026-one-dark-pro",
  "displayName": "Dark 2026 + One Dark Pro",
  "description": "Dark 2026 UI with One Dark Pro syntax and semantic highlighting.",
  "version": "1.2.27",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.111.0"
  },
  "categories": [
    "Themes"
  ],
  "main": "./src/extension.js",
  "activationEvents": ["onLanguage:cpp"],
  "extensionKind": ["ui"],
  "files": [
    "themes/**/*.json",
    "syntaxes/*.tmLanguage.json",
    "src/**/*.js",
    "media/*.css",
    "media/*.js",
    "media/*.png",
    "Dark2026-OneDarkPro.md"
  ],
  "repositorySharedFiles": { "src/custom-css.js": "custom-css.js" },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "python scripts/build_theme.py",
    "check": "node --check src/extension.js && node --check src/cpp-concepts.js && node --check src/cpp-enums.js && node --check media/synthwave84.js",
    "package": "python ../scripts/package_vsix.py ."
  },
  "contributes": {
    "grammars": [
      {
        "scopeName": "dark2026.cpp.modern",
        "path": "./syntaxes/cpp-modern.tmLanguage.json",
        "injectTo": ["source.cpp"]
      }
    ],
    "configuration": {
      "title": "Dark 2026 + One Dark Pro",
      "properties": {
        "dark2026OneDarkPro.cppConceptHighlighting": {
          "type": "boolean", "default": true,
          "description": "语言服务不提供 concept 语义分类时，借助转到定义补充稳定着色；提供原生分类时自动让原生语义高亮接管。关闭后仅使用语法和语言服务原生配色。"
        },
        "dark2026OneDarkPro.cppEnumTypeHighlighting": {
          "type": "boolean", "default": true,
          "description": "语言服务只提供通用 type 分类时，为枚举类型名及其同文件引用补充配色，保留普通类名与关键字原色。提供原生 enum 分类时自动使用原生语义高亮。"
        },
        "dark2026OneDarkPro.cppTemplateParameterHighlighting": {
          "type": "boolean", "default": true,
          "description": "为模板签名中的类型参数和值参数分别补充淡紫与杏橙配色；命名约束通过转到定义确认，内置类型和 auto 直接按语法识别。类型参数优先使用原生 typeParameter 分类；值参数单独补色，复杂声明保留语言服务原色。"
        },
        "dark2026OneDarkPro.glowIntensity": {
          "type": "number", "default": 1, "minimum": 0, "maximum": 2,
          "description": "代码光晕总强度。修改后运行启用或更新 Synthwave 光晕命令。"
        },
        "dark2026OneDarkPro.frequencyAware": {
          "type": "boolean", "default": true,
          "description": "按当前可见代码中各配色语义组的出现频次调整光晕，越常见越弱。"
        }
      }
    },
    "commands": [
      { "command": "dark2026OneDarkPro.enableGlow", "title": "启用或更新 Synthwave 光晕", "category": "Dark 2026" },
      { "command": "dark2026OneDarkPro.disableGlow", "title": "停用 Synthwave 光晕", "category": "Dark 2026" }
    ],
    "colors": [
      {
        "id": "dark2026OneDarkPro.glow",
        "description": "Marker for this theme's bundled Synthwave effects.",
        "defaults": { "dark": "#00000000", "light": "#00000000", "highContrast": "#00000000", "highContrastLight": "#00000000" }
      },
      {
        "id": "dark2026OneDarkPro.neonStart",
        "description": "Synthwave UI gradient start color.",
        "defaults": { "dark": "#9566FF", "light": "#9566FF", "highContrast": "#9566FF", "highContrastLight": "#9566FF" }
      },
      {
        "id": "dark2026OneDarkPro.neonMiddle",
        "description": "Synthwave UI gradient middle color.",
        "defaults": { "dark": "#478FFF", "light": "#478FFF", "highContrast": "#478FFF", "highContrastLight": "#478FFF" }
      },
      {
        "id": "dark2026OneDarkPro.neonEnd",
        "description": "Synthwave UI gradient end color.",
        "defaults": { "dark": "#03EDF9", "light": "#03EDF9", "highContrast": "#03EDF9", "highContrastLight": "#03EDF9" }
      }
    ],
    "themes": [
      {
        "id": "Dark 2026 + One Dark Pro",
        "label": "Dark 2026 + One Dark Pro",
        "uiTheme": "vs-dark",
        "path": "./themes/dark2026-one-dark-pro-color-theme.json"
      }
    ]
  }
}
