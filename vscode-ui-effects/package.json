{
  "name": "customize-imports-effects",
  "displayName": "Customize Imports Effects",
  "description": "Cursor trails, translucent widgets and a custom editor watermark.",
  "version": "0.1.8",
  "publisher": "local-tools",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "extensionKind": ["ui"],
  "main": "./src/extension.js",
  "files": ["src/**/*.js", "media/*.js", "media/*.css", "media/*.png"],
  "repositorySharedFiles": { "src/custom-css.js": "custom-css.js" },
  "scripts": {
    "check": "node --check src/extension.js && node --check media/trail-effect.js && node --check media/vim-cursor.js",
    "package": "python ../scripts/package_vsix.py ."
  },
  "contributes": {
    "commands": [
      { "command": "customizeImports.enable", "title": "启用或更新界面特效", "category": "Customize Imports" },
      { "command": "customizeImports.disable", "title": "停用界面特效", "category": "Customize Imports" }
    ],
    "configuration": {
      "title": "Customize Imports Effects",
      "properties": {
        "customizeImports.cursorTrail": { "type": "boolean", "default": true, "description": "显示光标拖尾。修改设置后运行启用或更新界面特效命令。" },
        "customizeImports.smoke": { "type": "boolean", "default": true, "description": "显示拖尾末端烟雾。" },
        "customizeImports.maxFPS": { "type": "number", "default": 60, "minimum": 15, "maximum": 240, "description": "拖尾绘制帧率上限，空闲或窗口失焦时暂停绘制。" },
        "customizeImports.interfaceStyles": { "type": "boolean", "default": true, "description": "启用半透明快速输入框、霓虹列表、调试工具栏与滚动滑块、编辑器高亮和渐变光标。" },
        "customizeImports.watermark": { "type": "boolean", "default": true, "description": "使用内置的编辑器水印。" }
      }
    }
  }
}
